# Copy to .env and fill in before running with Docker Compose or deploying.
# .env is gitignored; never commit real values.

# REQUIRED in production. Signs login tokens (HS256).
# Without it api/auth.py generates a random key per process, which silently
# logs everyone out on every restart.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port the app binds to. Fly.io and most PaaS providers inject this themselves.
PORT=8080

# Comma-separated browser origins allowed to call the API cross-origin.
# The site is served by the same app, so this is only needed for a separate
# frontend. Set it to your real domain in production — leaving the localhost
# default in place is harmless but useless.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Contact address sent to OpenAlex for the polite pool (higher rate limits).
# Also configurable in config/terms.yaml.
OPENALEX_MAILTO=
